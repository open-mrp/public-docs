{
    "name": "@augno/docs",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:docs": "go run main.go && bun run scripts/generate-api-reference.ts && bun run scripts/generate-nav.ts && bun run scripts/generate-slugs.ts",
        "index:docs": "bun run scripts/index-docs.ts",
        "start": "next start",
        "lint": "eslint .",
        "test": "bun test",
        "ui:link": "bunx yalc add @augno/ui && rm -rf .next && bunx yalc update",
        "ui:unlink": "rm -rf .next && bun remove @augno/ui && bun add @augno/ui@latest",
        "sdk:link": "bunx yalc add @augno/internal-sdk && rm -rf .next && bunx yalc update",
        "sdk:unlink": "rm -rf .next && bun remove @augno/internal-sdk && bun add @augno/internal-sdk@latest",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@augno/internal-sdk": "file:.yalc/@augno/internal-sdk",
        "@augno/ui": "^1.0.0",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@next/mdx": "16.0.7",
        "@types/mdx": "^2.0.13",
        "@xyflow/react": "^12.10.0",
        "algoliasearch": "^5.46.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^3.3.3",
        "dotenv": "^17.2.3",
        "glob": "^11.1.0",
        "gray-matter": "^4.0.3",
        "next": "16.0.7",
        "next-mdx-remote": "^5.0.0",
        "postcss": "^8.5.6",
        "raw-loader": "^4.0.2",
        "react": "19.2.1",
        "react-dom": "19.2.1",
        "react-instantsearch": "^7.22.1",
        "react-instantsearch-nextjs": "^1.0.11",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.4.0",
        "zod": "^3.25.76",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@types/node": "^20.19.27",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "eslint": "^9.39.2",
        "eslint-config-next": "16.0.7",
        "prettier": "^3.7.4",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3"
    }
}