{
    "name": "@augno/docs",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build",
        "build:docs": "go run main.go && bun run scripts/generate-api-reference.ts && bun run scripts/generate-nav.ts && bun run scripts/generate-slugs.ts && bun run scripts/generate-llms-txt.ts",
        "validate:pathkeys": "bun run scripts/validate-pathkeys.ts",
        "index:docs": "bun run scripts/index-docs.ts",
        "start": "next start",
        "lint": "eslint .",
        "test": "bun test",
        "ui:link": "bunx yalc add @augno/ui && rm -rf .next && bunx yalc update",
        "ui:unlink": "rm -rf .next && bun remove @augno/ui && bun add @augno/ui@latest",
        "sdk:link": "bunx yalc add @augno/internal-sdk && rm -rf .next && bunx yalc update",
        "sdk:unlink": "rm -rf .next && bun remove @augno/internal-sdk && bun add @augno/internal-sdk@latest",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@augno/internal-sdk": "^3.0.0",
        "@augno/ui": "^1.1.7",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@next/mdx": "16.1.6",
        "@types/mdx": "^2.0.13",
        "@vercel/analytics": "^1.6.1",
        "@xyflow/react": "^12.10.1",
        "algoliasearch": "^5.49.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^3.3.3",
        "dotenv": "^17.3.1",
        "glob": "^13.0.6",
        "gray-matter": "^4.0.3",
        "next": "16.1.6",
        "next-mdx-remote": "^6.0.0",
        "postcss": "^8.5.6",
        "raw-loader": "^4.0.2",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-instantsearch": "^7.26.0",
        "react-instantsearch-nextjs": "^1.1.0",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.5.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.2.1",
        "@types/node": "^25.3.2",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "eslint": "^10.0.2",
        "eslint-config-next": "16.1.6",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.2.1",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3"
    }
}
